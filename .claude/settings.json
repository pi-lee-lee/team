{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": {
    "bgIsolation": "none"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ownership_guard.py\""
          }
        ]
      },
      {
        "matcher": "Agent|Task|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/no_subagent_guard.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(/Users/idong-u/learn/team/bin/req.sh:*)",
      "Bash(/Users/idong-u/learn/team/bin/team-status.sh:*)",
      "Bash(team/bin/req.sh:*)",
      "Bash(team/bin/team-status.sh:*)",
      "Bash(bash team/bin/req.sh:*)",
      "Bash(bash team/bin/team-status.sh:*)",
      "Bash(python3 team/bin/teamctl.py:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(cat:*)",
      "Bash(pwd)",
      "Bash(true)",
      "Bash(test:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(date:*)",
      "Bash(which:*)",
      "Bash(command:*)",
      "Bash(readlink:*)",
      "Bash(realpath:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(diff:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git show:*)",
      "Bash(python3:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(cmake:*)",
      "Bash(make:*)",
      "Bash(g++:*)",
      "Bash(gcc:*)",
      "Bash(clang:*)",
      "Bash(clang++:*)",
      "Bash(pkg-config:*)",
      "Bash(gradle:*)",
      "Bash(./gradlew:*)",
      "Bash(adb:*)",
      "Bash(arduino-cli:*)",
      "Bash(pio:*)",
      "Bash(nc:*)",
      "Bash(socat:*)",
      "Bash(ss:*)",
      "Bash(lsof:*)",
      "Bash(mkdir:*)",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(claude stop:*)"
    ]
  }
}
