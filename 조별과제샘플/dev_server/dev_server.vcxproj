<?xml version="1.0" encoding="utf-8"?>
<!--
  Visual Studio 프로젝트 — 개발용 주차 서버

  🔴🔴 **컴파일 대상은 `server.cpp` **하나뿐** 이다. 이건 실수가 아니다.**

    이 서버는 **유니티 빌드**다 — `server.cpp` 가 나머지를 `#include` 로 끌어온다.
    `lot.cpp` 도 그중 하나다(`server.cpp` 안에 `#include "lot.cpp"` 가 있다).

    ⚠ **VS 가 폴더의 `.cpp` 를 자동으로 추가하면 `lot.cpp` 가 *따로* 컴파일된다.**
      그러면 `buildLot`·`onTick`·`onCmdResult` 가 **두 번 정의되고 링크가 깨진다.**
      🔑 그게 "VS 에서 빌드 오류"의 가장 유력한 원인이다 —
        `lot.cpp` 는 **혼자서도 문법이 통과하도록 일부러 만들어져 있어서**
        (편집기가 타입을 알아야 빨간 줄이 안 뜬다) VS 가 그것을 진짜 소스로 오해한다.

    ✅ 그래서 `lot.cpp` 와 헤더들은 `<None>` 으로 넣었다 —
      **IDE 에는 보이고 편집되지만 컴파일은 안 된다.**

  🔑 **이 목록은 낡지 않는다.** 컴파일 항목이 **영원히 하나**이기 때문이다.
    헤더를 몇 개 더 만들어도 `server.cpp` 가 `#include` 하면 그만이고 여기는 안 고친다.
    (`<None>` 목록은 IDE 표시용이라 빠져도 빌드가 안 깨진다.)

  ⚠ **`/utf-8` 을 빼지 마라.** 이 소스는 BOM 없는 UTF-8 이고 안내 문구가 한글이다.
    빼면 MSVC 가 시스템 코드페이지(CP949)로 읽어 문자열이 깨지는데
    **컴파일은 그대로 통과한다.** 빌드 로그로는 절대 못 잡고 **브라우저 화면에서 처음 보인다.**
    🔴 조용히 틀리는 것이라 플래그로 막는다.
-->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{7A1C0D31-4F2B-4C55-9E10-DEV5E12E0001}</ProjectGuid>
    <RootNamespace>dev_server</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp14</LanguageStandard>
      <!-- 🔴 한글 문자열이 깨지지 않게. 위 주석을 읽어라. -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <!-- `snprintf` 등에 C4996 을 띄우지 않게. POSIX 쪽과 같은 코드를 쓰기 위한 것이다. -->
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;WIN32_LEAN_AND_MEAN;BUILD_ID="vs-dev";%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <WarningLevel>Level3</WarningLevel>
      <ConformanceMode>true</ConformanceMode>
    </ClCompile>
    <Link>
      <!-- 🔑 소켓. 이게 없으면 `WSAStartup` 등이 전부 미해결 외부 기호가 된다. -->
      <AdditionalDependencies>ws2_32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <SubSystem>Console</SubSystem>
    </Link>
  </ItemDefinitionGroup>

  <!-- 🔴 컴파일되는 것은 이 하나뿐이다 -->
  <ItemGroup>
    <ClCompile Include="server.cpp" />
  </ItemGroup>

  <!-- 아래는 **IDE 표시용**이다. 컴파일되지 않는다.
       🔑 `lot.cpp` 가 여기 있는 것이 핵심이다 — 개발자가 여는 파일인데 **따로 컴파일되면 안 된다.** -->
  <ItemGroup>
    <None Include="lot.cpp" />
    <None Include="README.md" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="parking.h" />
    <ClInclude Include="spot.h" />
    <ClInclude Include="cmdresult.h" />
    <ClInclude Include="control.h" />
    <ClInclude Include="config.h" />
    <ClInclude Include="entry.h" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
